JOBS_DATABASE_URL=postgresql+psycopg://jobs_user:replace-me@localhost:5432/valases_jobs
JOBS_PUBLIC_ORIGIN=https://jobs.valases.com
JOBS_VALASES_API_URL=https://replace-with-valases-api.example/api
JOBS_CANDIDATE_PORTAL_URL=https://replace-with-candidate-portal.example
# Set the same independently generated secret on the Valases backend.
JOBS_BRIDGE_KEY=replace-with-at-least-32-random-characters
JOBS_SECURE_COOKIES=true
JOBS_DEMO=false
JOBS_CREATE_SCHEMA=false
JOBS_DEPLOYMENT_STAGE=production
# For a HTTPS staging deployment: JOBS_DEPLOYMENT_STAGE=staging and JOBS_CASHFREE_ENVIRONMENT=sandbox
JOBS_INDEXED_CATALOG=true
JOBS_REDIS_URL=redis://:replace-me@127.0.0.1:6379/2
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back up separately; losing this key loses access to stored resumes and queued email.
JOBS_ENCRYPTION_KEY=replace-with-generated-fernet-key
JOBS_SMTP_HOST=replace-with-mail-provider
JOBS_SMTP_PORT=587
JOBS_SMTP_USERNAME=replace-me
JOBS_SMTP_PASSWORD=replace-me
JOBS_SMTP_SENDER=replace-with-verified-sender@example.com
JOBS_SUPPORT_EMAIL=replace-with-support-address@example.com
JOBS_COMPANY_NAME=Valases
JOBS_REQUIRE_VERIFIED_EMAIL=true
JOBS_BILLING_ENABLED=true
JOBS_CASHFREE_APP_ID=replace-with-production-app-id
JOBS_CASHFREE_SECRET_KEY=replace-with-production-secret
JOBS_CASHFREE_ENVIRONMENT=production
JOBS_CASHFREE_API_VERSION=2025-01-01
JOBS_CATALOG_PAGE_LIMIT=1000

# Public preview needs no database/services and disables all real actions.
JOBS_PUBLIC_PREVIEW=false

# Vercel: use short scheduled tasks instead of a persistent worker.
JOBS_BACKGROUND_MODE=scheduled
# Independently generated scheduler secret; never put it in a query string.
JOBS_CRON_SECRET=replace-with-at-least-32-random-characters
